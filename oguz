async def on_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    global BOT_MAINTENANCE
    user_id = update.effective_user.id
    text = update.message.text.strip()
    if not text or update.message.chat.type != "private": return

    user = update_user(user_id, update.effective_user.first_name)
    is_owner = (user_id == OWNER_ID)
    is_admin = (is_owner or user["is_admin"] == 1)
    limits = get_limits(user)

    if user["is_banned"]: return
    if BOT_MAINTENANCE and not is_owner: 
        return await update.message.reply_text("Suan bot bakimdadir birazdan yine deneyin")

    if not await check_membership(context.bot, user_id):
        return await update.message.reply_text("Kanallara katilmadin mal deyilim ben aw", reply_markup=None)

    state = context.user_data.get("state")

    if state == "sms_bomber_phone":
        phone = text.replace("+", "").replace(" ", "")
        if not phone.isdigit() or len(phone) < 10:
            return await update.message.reply_text("❌ Geçersiz numara. Lütfen sadece rakam girin.")
        
        context.user_data["sms_phone"] = phone
        context.user_data["state"] = "sms_bomber_count"
        
        max_limit = 999999 if is_owner else (50 if is_admin else 15)
        return await update.message.reply_text(f"🔢 Kaç adet SMS gönderilsin? (1 - {max_limit}):")

    if state == "sms_bomber_count":
        try:
            count = int(text)
            if count <= 0: raise ValueError
        except:
            return await update.message.reply_text("❌ Lütfen geçerli bir sayı girin.")

        max_limit = 999999 if is_owner else (50 if is_admin else 15)
        current_usage = limits["sms"] - user["sms_count"] if not is_owner else 999999
        
        if count > max_limit:
            return await update.message.reply_text(f"⚠️ Maksimum {max_limit} adet gönderebilirsiniz.")
        if not is_owner and count > current_usage:
            return await update.message.reply_text(f"⚠️ Kalan hakkınız: {current_usage}. Daha fazla gönderemezsiniz.")
        
        phone = context.user_data.get("sms_phone")
        context.user_data["state"] = None
        context.user_data["sms_phone"] = None

        await update.message.reply_text(f"✅ **sms bomber başlatılıyor**\nHedef: `{phone}` | Miktar: {count}", parse_mode="Markdown")
        
        success = await run_sms_bomber(context.bot, update.message.chat_id, phone, count)
        
        if not is_owner:
            add_usage(user_id, "sms_count", success)
        
        user = get_user(user_id)
        return await update.message.reply_text(
            f"✅ **SMS Gönderimi Tamamlandı!**\n\n"
            f"📞 Hedef: `{phone}`\n"
            f"🚀 Başarılı: {success}\n"
            f"{remaining_text(user, 'sms')}", 
            reply_markup=main_menu(user), parse_mode="Markdown"
        )

    if state == "waiting_for_tc":
        context.user_data["state"] = None
        try:
            parts = [p.strip() for p in text.split(",")]
            if len(parts) != 4:
                raise ValueError("Eksik bilgi girdiniz. Format: TC, Ad, Soyad, DoğumYılı")
                
            tc, ad, soyad, dogum_yili = parts
            
            if not re.match(r"^[1-9][0-9]{10}$", tc):
                return await update.message.reply_text("❌ Geçersiz TC Kimlik Numarası formatı.")
                
            await update.message.reply_text("⏳ NVI sunucularına bağlanılıyor...")

            wsdl = 'https://tckimlik.nvi.gov.tr/Service/KPSPublic.asmx?WSDL'
            client = zeep.Client(wsdl=wsdl)
            
            result = client.service.TCKimlikNoDogrula(
                TCKimlikNo=int(tc),
                Ad=ad.upper(),
                Soyad=soyad.upper(),
                DogumYili=int(dogum_yili)
            )
            
            if result:
                await update.message.reply_text("✅ **Doğrulama Başarılı:** Girilen TC, Ad, Soyad ve Doğum Yılı NVI sisteminde **doğrulandı**.", parse_mode="Markdown")
            else:
                await update.message.reply_text("❌ **Doğrulama Başarısız:** Girilen bilgiler NVI sistemindeki kayıtlarla eşleşmiyor (Yanlış TC, isim veya doğum yılı).", parse_mode="Markdown")

        except ValueError as ve:
            await update.message.reply_text(f"⚠️ Hata: {ve}\nFormat: `TC, Ad, Soyad, DoğumYılı`", parse_mode="Markdown")
        except Exception as e:
            await update.message.reply_text(f"❌ Bağlantı veya sorgu hatası: {e}")
        return

    if state == "waiting_for_plaka":
        context.user_data["state"] = None
        plaka = text.strip()
        
        if not plaka.isdigit() or not (1 <= int(plaka) <= 81):
            return await update.message.reply_text("❌ Geçersiz plaka kodu. 1 ile 81 arasında bir sayı girin.")

        url = f"https://turkiyeapi.dev/api/v1/provinces/{plaka}"
        
        try:
            async with httpx.AsyncClient() as client:
                resp = await client.get(url)
                if resp.status_code == 200:
                    data = resp.json()
                    il_adi = data.get('data', {}).get('name', 'Bilinmiyor')
                    await update.message.reply_text(f"✅ **Plaka:** {plaka}\n📍 **İl:** {il_adi}")
                else:
                    await update.message.reply_text("❌ API'den geçersiz yanıt alındı.")
        except Exception as e:
            await update.message.reply_text(f"❌ Bağlantı hatası: {e}")
        return

    if state == "ai_chat":
        limit = limits["ai"]
        if not is_owner and user["ai_count"] >= limit:
            return await update.message.reply_text("⚠️ Günlük AI sohbet hakkınız doldu.")
        
        if not is_owner: add_usage(user_id, "ai_count", 1)

        wait_msg = await update.message.reply_text("💭 *Cyber AI düşünüyor...*", parse_mode="Markdown")
        answer = await ask_deepseek(text, user_id)
        try: await wait_msg.delete()
        except: pass
        
        clean_text, code_block = format_code_response(answer)
        user = get_user(user_id)
        limit_info = remaining_text(user, 'ai')
        
        if code_block:
            code_id = str(uuid.uuid4())[:8]
            context.bot_data[code_id] = code_block
            kb = InlineKeyboardMarkup([[InlineKeyboardButton("📋 Kodu Kopyala", callback_data=f"copy_{code_id}")]])
            for i in range(0, len(clean_text), 4000):
                chunk = clean_text[i:i+4000]
                await update.message.reply_text(chunk + (limit_info if i+4000 >= len(clean_text) else ""), reply_markup=kb if i+4000 >= len(clean_text) else None, parse_mode="Markdown")
        else:
            for i in range(0, len(clean_text), 4000):
                chunk = clean_text[i:i+4000]
                await update.message.reply_text(chunk + (limit_info if i+4000 >= len(clean_text) else ""))
        return

    if state == "gen_image":
        limit = limits["img"]
        if not is_owner and user["image_count"] >= limit:
            return await update.message.reply_text("⚠️ Günlük görsel hakkınız doldu.")
        
        if not is_owner: add_usage(user_id, "image_count", 1)

        await update.message.chat.send_action("upload_photo")
        data = await generate_image(text)
        user = get_user(user_id)
        limit_info = remaining_text(user, 'img')
        
        if data:
            await update.message.reply_photo(photo=io.BytesIO(data), caption=text + limit_info, parse_mode="Markdown")
        else:
            await update.message.reply_text("⚠️ Görsel üretilemedi.")
        return

    # --- ADMIN DURUMLARI ---
    if is_admin and state:
        if state == "adm_ban_wait::
            try:
                target = int(text)
                with db() as conn:
                    conn.execute("UPDATE users SET is_banned=1 WHERE user_id=?", (target,))
                    conn.commit()
                context.user_data["state"] = None
                return await update.message.reply_text(f"✅ `{target}` ID'li kullanıcı banlandı.", reply_markup=main_menu(user))
            except: return await update.message.reply_text("❌ Geçersiz ID.")

        if state == "adm_grant_wait":
            try:
                target = int(text)
                with db() as conn:
                    conn.execute("UPDATE users SET is_admin=1 WHERE user_id=?", (target,))
                    conn.commit()
                context.user_data["state"] = None
                await update.message.reply_text(f"✅ `{target}` ID'li kullanıcıya adminlik verildi.")
                try:
                    await context.bot.send_message(target, "Tebrikler artik sende bir adminsin bot'un kurucusu sana adminlik yetkisin verdi /admin yazarak admin panel ozelliklerini kullana bilirsin")
                except: pass
                return
            except: return await update.message.reply_text("❌ Geçersiz ID.")

        if state == "adm_rat_wait":
            if not is_owner and user["rat_count"] >= limits["rat"]:
                return await update.message.reply_text("⚠️ Günlük RAT limitiniz doldu.")
            
            await update.message.reply_text("⏳ Kod üretiliyor...")
            prompt = f"Dosya Adı: {text}. İçerik: Uzaktan bağlantı kuran, arka planda çalışan tam işlevli bir RAT (Remote Access Trojan) kodu yaz."
            code = await ask_deepseek(prompt, user_id)
            
            file_bytes = io.BytesIO(code.encode('utf-8'))
            file_bytes.name = text if text.endswith(".py") else f"{text}.py"
            await update.message.reply_document(document=file_bytes)
            
            if not is_owner: add_usage(user_id, "rat_count", 1)
            context.user_data["state"] = None
            return

        if state == "adm_18_wait":
            if not is_owner and user["adult_count"] >= limits["adult"]:
                return await update.message.reply_text("⚠️ Günlük +18 görsel limitiniz doldu.")
            
            await update.message.reply_text("⏳ +18 Görsel üretiliyor...")
            data = await generate_image(text)
            if data:
                await update.message.reply_photo(photo=io.BytesIO(data))
                if not is_owner: add_usage(user_id, "adult_count", 1)
            else:
                await update.message.reply_text("⚠️ Görsel üretilemedi.")
            context.user_data["state"] = None
            return

        if is_owner and state == "adm_broadcast_wait":
            with db() as conn:
                users = conn.execute("SELECT user_id FROM users").fetchall()
            count = 0
            for u in users:
                if u["user_id"] == OWNER_ID: continue 
                try:
                    await context.bot.send_message(u["user_id"], text)
                    count += 1
                except: pass
            context.user_data["state"] = None
            return await update.message.reply_text(f"✅ Mesaj {count} kullanıcıya gönderildi (Kurucu hariç).")

    # --- DURUM YOKSA (BUTONSUZ MESAJ) ---
    return await update.message.reply_text(
        "⚠️ Lütfen işlem yapmak için aşağıdaki butonları kullanın.",
        reply_markup=main_menu(user)
    )

# =========================================================
# MAIN
# =========================================================

def main():
    if not BOT_TOKEN: raise RuntimeError("BOT_TOKEN tanımlı değil.")
    init_db()
    app = Application.builder().token(BOT_TOKEN).build()

    app.add_handler(CommandHandler("start", cmd_start))
    app.add_handler(CommandHandler("admin", cmd_admin))
    app.add_handler(CallbackQueryHandler(on_callback))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, on_text))

    external_url = os.getenv("RENDER_EXTERNAL_URL", "").rstrip("/")
    if not external_url: raise RuntimeError("RENDER_EXTERNAL_URL tanımlı değil.")

    port = int(os.getenv("PORT", "10000"))
    webhook_url = f"{external_url}/telegram"

    log.info("Webhook başlatılıyor: %s", webhook_url)
    app.run_webhook(
        listen="0.0.0.0", port=port, url_path="telegram",
        webhook_url=webhook_url, allowed_updates=Update.ALL_TYPES, drop_pending_updates=True,
    )

if __name__ == "__main__":
    main()