def db():
    conn = sqlite3.connect(DB_PATH, check_same_thread=False)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    with db() as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                first_name TEXT DEFAULT '',
                is_admin INTEGER DEFAULT 0,
                is_banned INTEGER DEFAULT 0,
                ai_count INTEGER DEFAULT 0,
                image_count INTEGER DEFAULT 0,
                rat_count INTEGER DEFAULT 0,
                adult_count INTEGER DEFAULT 0,
                sms_count INTEGER DEFAULT 0,
                email_count INTEGER DEFAULT 0,
                last_reset DATE DEFAULT (date('now', 'localtime')),
                last_used TEXT DEFAULT '',
                last_start TEXT DEFAULT ''
            )
        """)
        conn.commit()

def get_user(user_id):
    with db() as conn:
        return conn.execute("SELECT * FROM users WHERE user_id=?", (user_id,)).fetchone()

def update_user(user_id, first_name=""):
    today = datetime.now(TR_TZ).date().isoformat()
    now_str = datetime.now(TR_TZ).strftime("%Y-%m-%d %H:%M:%S")
    
    with db() as conn:
        user = conn.execute("SELECT * FROM users WHERE user_id=?", (user_id,)).fetchone()
        if not user:
            conn.execute("INSERT INTO users (user_id, first_name, last_start, last_used, last_reset) VALUES (?, ?, ?, ?, ?)", (user_id, first_name, now_str, now_str, today))
        else:
            conn.execute("UPDATE users SET first_name=?, last_used=? WHERE user_id=?", (first_name, now_str, user_id))
            if user["last_reset"] != today:
                conn.execute("UPDATE users SET ai_count=0, image_count=0, rat_count=0, adult_count=0, sms_count=0, email_count=0, last_reset=? WHERE user_id=?", (today, user_id))
        conn.commit()
    return get_user(user_id)

def add_usage(user_id, field, amount=1):
    with db() as conn:
        conn.execute(f"UPDATE users SET {field}={field}+? WHERE user_id=?", (amount, user_id))
        conn.commit()

